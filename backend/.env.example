# OntoWeave 后端配置。复制成 .env 后填写（.env 已在 .gitignore 里）。

# ---------- 数据库 ----------
DATABASE_URL=postgresql+psycopg://ontoweave:ontoweave@localhost:5432/ontoweave
POSTGRES_USER=ontoweave
POSTGRES_PASSWORD=ontoweave
POSTGRES_DB=ontoweave

# 测试库。注意：pytest 直接读环境变量，不会加载 .env，
# 所以要跑测试的话用 `export TEST_DATABASE_URL=...` 或直接用默认值。
TEST_DATABASE_URL=postgresql+psycopg://ontoweave:ontoweave@localhost:5432/ontoweave_test

# ---------- 用户（一期没有用户系统，先固定）----------
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# ---------- 对话模型（智能体用）----------
# OpenAI 兼容接口。私有化部署把 BASE_URL 换成自建网关即可。
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=
CHAT_MODEL=gpt-4o-mini
CHAT_TEMPERATURE=0
CHAT_TIMEOUT_SECONDS=60
# 推理模型必须给足 token，否则会得到「200 但正文为空」的响应
CHAT_MAX_TOKENS=4096
CHAT_REASONING_EFFORT=

# ---------- 嵌入模型（相似检索用）----------
# 维度必须和数据库里 object_type.embedding 列的维度一致（当前 1536）。
# 换成原生维度不是 1536 的模型时，要么打开 EMBEDDING_SEND_DIMENSIONS
# 让服务端按 1536 输出，要么改列维度并生成一次迁移。
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_TIMEOUT_SECONDS=30
# 有些 OpenAI 兼容实现不认 dimensions 字段，报错就改成 false。
EMBEDDING_SEND_DIMENSIONS=true

# ---------- 智能体运行时----------
AGENT_MAX_ITERATIONS=12

# ---------- 可观测性：Langfuse 审计追踪（可选）----------
# 填入 public/secret key 即开启；两个都留空则完全不追踪，零开销。
# 自托管把 LANGFUSE_BASE_URL 换成本地实例，例如 http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 区分环境 / 版本，方便在 Langfuse 里过滤。
LANGFUSE_ENVIRONMENT=dev
LANGFUSE_RELEASE=
